-- ==================== ZONE-RESTRICTED AUTO OPEN RELIC & HALLOWEEN BOXES ==================== --
local function GetZoneRelicBoxes()
    local root = GetChar()
    if not root then return {} end
    local pPos = root.Position
    local serverTime = workspace:GetServerTimeNow()

    local curZoneId = CurrentZoneId or GetZoneAtZ(pPos.Z)
    local zr = nil
    if curZoneId then
        for _, r in ipairs(ZoneRanges) do
            if r.id == curZoneId then
                zr = r
                break
            end
        end
    end

    local eligible = {}
    local seen = {}

    local function evaluateBox(bPart, bModel)
        if not bPart or not bPart:IsA("BasePart") or not bPart.Parent then return end
        if seen[bPart] then return end
        seen[bPart] = true

        local ownerId = tonumber(bPart:GetAttribute("OwnerUserId")) or 0
        local freeAt = tonumber(bPart:GetAttribute("FreeAt")) or 0
        local isUnlocked = (ownerId == 0 or ownerId == LocalPlayer.UserId or serverTime >= freeAt)
        if not isUnlocked then return end

        local inZone = false
        if zr then
            inZone = (bPart.Position.Z >= zr.minZ and bPart.Position.Z < zr.maxZ)
        else
            inZone = ((bPart.Position - pPos).Magnitude <= 160)
        end

        if inZone then
            local dist = (bPart.Position - pPos).Magnitude
            table.insert(eligible, {
                part = bPart,
                model = bModel or bPart.Parent,
                dist = dist
            })
        end
    end

    for _, bPart in ipairs(CollectionService:GetTagged("LootBox")) do
        evaluateBox(bPart, bPart.Parent)
    end

    for _, obj in ipairs(workspace:GetChildren()) do
        if obj:IsA("Model") and (obj.Name:find("LootBoxModel") or obj.Name:find("relic_box") or obj.Name:find("Halloween")) then
            local bPart = obj:FindFirstChild("LootBox_relic_box") or obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
            if bPart then
                evaluateBox(bPart, obj)
            end
        end
    end

    table.sort(eligible, function(a, b) return a.dist < b.dist end)
    return eligible
end

local function OpenNearbyRelicBox()
    local root, hum = GetChar()
    if not root or not hum or hum.Health <= 0 or IsOpeningChest then return end

    local boxes = GetZoneRelicBoxes()
    if #boxes == 0 then return end

    local target = boxes[1]
    local bPart = target.part
    local bModel = target.model

    IsOpeningChest = true
    local origCF = root.CFrame
