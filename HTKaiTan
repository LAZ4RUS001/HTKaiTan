    if IsProcessingEventNpc and not isInitialRun then return end

    local eventAttr = LocalPlayer:GetAttribute("EventJson")
    local eventData = (type(eventAttr) == "string" and HttpService:JSONDecode(eventAttr)) or {}
    local got = eventData.Got or {}
    local liked = (eventData.Liked == true)
    local group = (eventData.Group == true)
    local pLvl = GetPlayerLevel()

