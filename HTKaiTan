local function GetUnlockedGates()
    local raw = LocalPlayer:GetAttribute("BossGatesJson")
    if type(raw) == "string" then
        local ok, decoded = pcall(function() return HttpService:JSONDecode(raw) end)
        if ok and type(decoded) == "table" then
            return decoded
        end
    end
    return {}
end

local function GetTargetZoneForLevel(lvl)
    local gates = GetUnlockedGates()

    -- 1. Check if intermediate boss rooms must be cleared first before entering next zones
    if lvl >= 25 and gates["Boss01"] ~= true then
        return "Boss01", "Boss Room 01 · Gorilla King (Lv.25 [UNLOCK REQUIRED])"
    end
    if lvl >= 50 and gates["Boss02"] ~= true then
        return "Boss02", "Boss Room 02 · Whitefang Sabertooth (Lv.50 [UNLOCK REQUIRED])"
    end
    if lvl >= 75 and gates["Boss03"] ~= true then
        return "Boss03", "Boss Room 03 · Obsidian Pharaoh (Lv.75 [UNLOCK REQUIRED])"
    end
    if lvl >= 99 and gates["Boss04"] ~= true then
        return "Boss04", "Boss Room 04 · Tempest Dragon King (Lv.99 [UNLOCK REQUIRED])"
    end

    -- 2. Find target zone: Pick the highest level bracket that is fully unlocked in BossGatesJson
    -- CRITICAL: Skip any Boss Room where the boss gate is already unlocked! Boss rooms are never for regular grinding.
    local chosen = LevelProgression[1]
    for _, info in ipairs(LevelProgression) do
        -- If this is a boss room and it has already been unlocked/defeated, do NOT stay in it!
        if info.isBossRoom and gates[info.bossGateId] == true then
            continue
        end

        if lvl >= info.minLv then
            local isUnlocked = true
            if info.reqGate and gates[info.reqGate] ~= true then
                isUnlocked = false
            end
            if isUnlocked then
                chosen = info
            end
        end
    end

    return chosen.zoneId, chosen.name
end

local function GetBestHpPotionForLevel(lvl)
    if lvl <= 25 then
        return "red_potion", 20
    elseif lvl <= 50 then
        return "red_potion_m", 100
    else
        return "white_potion", 600
    end
end

local function GetPreviousFarmZone(targetZoneId)
    local curIdx = nil
    for idx, info in ipairs(LevelProgression) do
        if info.zoneId == targetZoneId then
            curIdx = idx
            break
        end
    end
    if not curIdx then
        return targetZoneId, targetZoneId
    end

    -- Look backwards for the previous non-boss field
    for idx = curIdx - 1, 1, -1 do
        local info = LevelProgression[idx]
        if not info.isBossRoom then
            return info.zoneId, info.name
        end
    end

    -- Fallback to first field
    return LevelProgression[1].zoneId, LevelProgression[1].name
end

local function GetEffectiveTargetZone(lvl)
    local baseZoneId, baseName = GetTargetZoneForLevel(lvl)
    if Config.RetreatOnHighDeaths and IsRetreatingForPotions then
        local prevZoneId, prevName = GetPreviousFarmZone(baseZoneId)
        return prevZoneId, prevName .. " [POTION FARM]"
    end
    return baseZoneId, baseName
end

