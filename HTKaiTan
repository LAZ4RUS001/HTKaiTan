-- Safe UI Parent Resolver (Supports gethui, PlayerGui, CoreGui across Solara, Delta, Fluxus, Codex, Arceus X)
local function GetSafeGuiParent()
    local target = nil
    if gethui and type(gethui) == "function" then
        pcall(function()
            local h = gethui()
            if h and typeof(h) == "Instance" then
                target = h
            end
        end)
    end
    if not target then
        pcall(function()
            target = LocalPlayer:WaitForChild("PlayerGui", 5)
        end)
    end
    if not target and CoreGui then
        pcall(function()
            local _ = CoreGui.Name
            target = CoreGui
        end)
    end
    return target or LocalPlayer:FindFirstChild("PlayerGui")
end

-- Safe GUI Destroyer (Never throws Level 3 identity / CoreGui access error on Solara)
local function SafeDestroyGui(guiName)
    local containers = {}
    pcall(function()
        if gethui and type(gethui) == "function" then
            local h = gethui()
            if h then table.insert(containers, h) end
        end
    end)
    if CoreGui then
        pcall(function()
            local _ = CoreGui.Name
            table.insert(containers, CoreGui)
            local rGui = CoreGui:FindFirstChild("RobloxGui")
            if rGui then table.insert(containers, rGui) end
        end)
    end
    pcall(function()
        local pGui = LocalPlayer:FindFirstChild("PlayerGui")
        if pGui then table.insert(containers, pGui) end
    end)
    for _, cont in ipairs(containers) do
        pcall(function()
            for _, child in ipairs(cont:GetChildren()) do
                if child.Name == guiName then
                    child:Destroy()
                end
            end
        end)
    end
end

-- Universal Button Click Emulator (Firesignal, getconnections, VirtualInputManager Touch/Mouse, VirtualUser)
local function UniversalClickButton(btn)
    if not btn or not btn:IsA("GuiButton") then return false end
    local clicked = false

    -- 1. firesignal
    if firesignal and type(firesignal) == "function" then
        pcall(function()
            firesignal(btn.MouseButton1Click)
            firesignal(btn.Activated)
            clicked = true
        end)
    end

    -- 2. getconnections
    if getconnections and type(getconnections) == "function" then
        pcall(function()
            for _, c in ipairs(getconnections(btn.MouseButton1Click)) do
                if c.Fire then c:Fire() elseif c.fire then c:fire() end
                clicked = true
            end
            for _, c in ipairs(getconnections(btn.Activated)) do
                if c.Fire then c:Fire() elseif c.fire then c:fire() end
                clicked = true
            end
        end)
    end

    -- 3. VirtualInputManager (Desktop mouse click / Mobile touch event)
    if VirtualInputManager then
        pcall(function()
            local pos = btn.AbsolutePosition + (btn.AbsoluteSize / 2)
            if IsMobilePlatform then
                VirtualInputManager:SendTouchEvent(1, 0, pos.X, pos.Y)
                task.wait(0.02)
                VirtualInputManager:SendTouchEvent(1, 2, pos.X, pos.Y)
            else
                VirtualInputManager:SendMouseButtonEvent(pos.X, pos.Y, 0, true, game, 1)
                task.wait(0.02)
                VirtualInputManager:SendMouseButtonEvent(pos.X, pos.Y, 0, false, game, 1)
            end
            clicked = true
        end)
    end

    -- 4. VirtualUser fallback
    if not clicked and VirtualUser then
        pcall(function()
            VirtualUser:CaptureController()
            local pos = btn.AbsolutePosition + (btn.AbsoluteSize / 2)
            VirtualUser:ClickButton1(pos)
            clicked = true
        end)
    end

    return clicked
end

-- Universal HTTP Request (Solara, Delta, Fluxus, Hydrogen, Codex, Arceus X, Synapse)
local function GetUniversalRequest()
    if type(request) == "function" then return request end
