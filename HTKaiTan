    if onData.At then
        sec = sec + math.min(math.max(0, workspace:GetServerTimeNow() - onData.At), 75)
    end

    local onlineThresholds = {
        [1] = { sec = 300, min = 5 },
        [2] = { sec = 900, min = 15 },
        [3] = { sec = 1800, min = 30 },
        [4] = { sec = 3600, min = 60 },
        [5] = { sec = 7200, min = 120 },
        [6] = { sec = 10800, min = 180 }
    }

    for idx = 1, 6 do
        local th = onlineThresholds[idx]
        if not gotOnline[idx] and sec >= th.sec then
            pcall(function()
                Remotes.RewardAction:FireServer("online", idx)
                print(string.format("[spinach] Claimed Online Playtime Reward Slot %d (%d min)", idx, th.min))
            end)
            task.wait(0.1)
        end
    end
end

local function ProcessMonthlyCheckin(rData)
    local Month = rData.Month
    if type(Month) ~= "table" then return end

    local today = Month.Today
    local checkedDays = {}
    if type(Month.Days) == "table" then
        for _, d in ipairs(Month.Days) do checkedDays[d] = true end
    end

    -- 1. Check in today
    if today and not checkedDays[today] then
        pcall(function()
            Remotes.RewardAction:FireServer("month", nil)
            print(string.format("[spinach] Claimed Monthly Check-in for Day %d", today))
        end)
        task.wait(0.2)
    end

    -- 2. Claim Missed Days with Free Make-up Check-ins
    local makeupLeft = Month.MakeupLeft or 0
    if today and makeupLeft > 0 then
        for d = 1, today - 1 do
            if not checkedDays[d] and makeupLeft > 0 then
                pcall(function()
                    Remotes.RewardAction:FireServer("makeup", d)
                    print(string.format("[spinach] Used Make-up Check-in for Day %d (Remaining: %d)", d, makeupLeft - 1))
                end)
                makeupLeft = makeupLeft - 1
                checkedDays[d] = true
                task.wait(0.2)
            end
        end
    end

    -- 3. Monthly Streak Milestones (7, 14, 21, 28 days based on game RewardData)
    local daysCount = type(Month.Days) == "table" and #Month.Days or 0
    local milesGot = {}
    if type(Month.Miles) == "table" then
        for _, m in ipairs(Month.Miles) do milesGot[m] = true end
    end
    local targetMilestones = {7, 14, 21, 28}
    pcall(function()
        local Shared = ReplicatedStorage:FindFirstChild("Shared")
        if Shared and Shared:FindFirstChild("RewardData") then
            local rd = require(Shared.RewardData)
            if rd and rd.Milestones then
                targetMilestones = {}
                for _, mInfo in ipairs(rd.Milestones) do
                    if mInfo.Days then table.insert(targetMilestones, mInfo.Days) end
                end
            end
        end
    end)
    if not _G.KaiTan_ClaimedMilestones then _G.KaiTan_ClaimedMilestones = {} end
    for _, reqDays in ipairs(targetMilestones) do
        if not milesGot[reqDays] and not _G.KaiTan_ClaimedMilestones[reqDays] and daysCount >= reqDays then
            _G.KaiTan_ClaimedMilestones[reqDays] = true
            pcall(function()
                Remotes.RewardAction:FireServer("mile", reqDays)
                print(string.format("[spinach] Claimed Monthly Streak Milestone: %d Days", reqDays))
            end)
            task.wait(0.2)
        end
    end
end

