local function GetActiveHasteBuff()
    local buffsRaw = LocalPlayer:GetAttribute("BuffsJson")
    if type(buffsRaw) ~= "string" or buffsRaw == "" then return nil, 0, 0 end
    local ok, buffs = pcall(function() return HttpService:JSONDecode(buffsRaw) end)
    if not ok or type(buffs) ~= "table" then return nil, 0, 0 end

    local now = workspace:GetServerTimeNow()
    for _, b in ipairs(buffs) do
        local rem = (tonumber(b.EndsAt) or 0) - now
        if rem > 3.0 then
            if b.Id == "haste5" then
                return "haste5", 3, rem
            elseif b.Id == "haste4" then
                return "haste4", 2, rem
            elseif b.Id == "haste3" then
                return "haste3", 1, rem
            end
        end
    end
    return nil, 0, 0
end

local function GetBestEligibleSpeedPotion()
    local curLevel = GetPlayerLevel()
    local itemsRaw = LocalPlayer:GetAttribute("ItemsJson")
    local items = (type(itemsRaw) == "string" and HttpService:JSONDecode(itemsRaw)) or {}

    for _, pot in ipairs(SpeedPotions) do
        if curLevel >= pot.minLevel then
            local count = tonumber(items[pot.itemId]) or 0
            if count > 0 then
                return pot, count
            end
        end
    end
    return nil, 0
end

local function GetBestSpeedPotionToBuy(curLevel)
    for _, pot in ipairs(SpeedPotions) do
        if curLevel >= pot.minLevel then
            return pot
        end
    end
    return SpeedPotions[#SpeedPotions]
end

local function ProcessAutoSpeedPotion()
    if not Config.AutoSpeedPotion then return end
    local root, hum = GetChar()
    if not root or not hum or hum.Health <= 0 or IsRespawning then return end

    local now = os.clock()
    if now - LastSpeedPotionUseTime < 2.0 then return end

    local activeBuff, activeTier, remTime = GetActiveHasteBuff()
    local bestPot, count = GetBestEligibleSpeedPotion()

    if not bestPot then
        return
    end

    -- If active buff is already equal or higher tier with time remaining, do not waste
    if activeBuff and activeTier >= bestPot.tier then
        return
    end

    LastSpeedPotionUseTime = now
    Remotes.UseItem:FireServer(bestPot.itemId)
    print(string.format("[spinach] Used Speed Potion: %s (Tier %d, Remaining in bag: %d, Active Buff: %s)",
        bestPot.name, bestPot.tier, count - 1, activeBuff or "None"))
end

-- ==================== AUTO BUY POTIONS SYSTEM ==================== --
local function GetBestHpPotionForLevel(lvl)
    if lvl <= 25 then
        return "red_potion", 20
    elseif lvl <= 50 then
        return "red_potion_m", 100
    else
        return "white_potion", 600
    end
end

local function ProcessAutoBuyPotions()
    if not Config.AutoBuyPotions or IsBuyingPotions or IsProcessingEventNpc then return end
    local now = os.clock()
    if now - LastPotionBuyTime < 8.0 then return end

    local itemsRaw = LocalPlayer:GetAttribute("ItemsJson")
    local items = (type(itemsRaw) == "string" and HttpService:JSONDecode(itemsRaw)) or {}
    local silver = tonumber(LocalPlayer:GetAttribute("Silver")) or 0

    local curLvl = GetPlayerLevel()
    local targetHpPot, hpPotCost = GetBestHpPotionForLevel(curLvl)
    local curHpPotCount = tonumber(items[targetHpPot]) or 0
    local curSpPotCount = tonumber(items["blue_potion"]) or 0

    local needHp = 0
    if curHpPotCount < (Config.MinHpPotions or 5) then
        needHp = math.max(0, (Config.TargetHpPotions or 100) - curHpPotCount)
    end

    local needSp = 0
    if curSpPotCount < (Config.MinSpPotions or 5) then
        needSp = math.max(0, (Config.TargetSpPotions or 100) - curSpPotCount)
    end

    local needSpeed = 0
    local targetSpeedPot = nil
    local speedPotCost = 0
    if Config.AutoBuySpeedPotion then
        local potInfo = GetBestSpeedPotionToBuy(curLvl)
        if potInfo then
            targetSpeedPot = potInfo.itemId
            speedPotCost = potInfo.cost
            local curSpeedPotCount = tonumber(items[targetSpeedPot]) or 0
            if curSpeedPotCount < (Config.MinSpeedPotions or 1) then
                needSpeed = math.max(0, (Config.TargetSpeedPotions or 3) - curSpeedPotCount)
            end
        end
    end

    if needHp <= 0 and needSp <= 0 and needSpeed <= 0 then return end

    -- Guard: Never abandon an active boss fight to buy potions
    if CurrentTarget and CurrentTarget.Parent and IsBossMob(CurrentTarget) then
        local bHp = tonumber(CurrentTarget:GetAttribute("HP")) or 0
        if bHp > 0 then
            return
        end
    end

    -- Check if affordable
    if silver < hpPotCost and silver < 200 and silver < speedPotCost then return end

    -- Budget allocation if low on silver
    local totalCost = (needHp * hpPotCost) + (needSp * 200) + (needSpeed * speedPotCost)
    if totalCost > silver then
        local hpBudget = math.floor(silver * 0.50)
        local spBudget = math.floor(silver * 0.25)
        local speedBudget = silver - hpBudget - spBudget

        needHp = math.min(needHp, math.floor(hpBudget / hpPotCost))
        needSp = math.min(needSp, math.floor(spBudget / 200))
        if speedPotCost > 0 then
            needSpeed = math.min(needSpeed, math.floor(speedBudget / speedPotCost))
        else
            needSpeed = 0
        end
    end

    if needHp <= 0 and needSp <= 0 and needSpeed <= 0 then return end

    IsBuyingPotions = true
    LastPotionBuyTime = now

    task.spawn(function()
        pcall(function()
            local root = GetChar()
            if not root then return end

            local savedZoneId = CurrentZoneId
