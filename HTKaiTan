    local needsPet = false
    local petAttr = LocalPlayer:GetAttribute("PetJson")
    local pDec = (type(petAttr) == "string" and pcall(function() return HttpService:JSONDecode(petAttr) end) and HttpService:JSONDecode(petAttr)) or nil
