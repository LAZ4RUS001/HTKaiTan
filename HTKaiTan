end

-- ==================== SCRIPT LIFECYCLE & THREAD PURGE ==================== --
local ScriptInstanceId = tostring(os.clock()) .. "_" .. tostring(math.random(10000, 99999))
if _G.KaiTan_Cleanup then
    pcall(_G.KaiTan_Cleanup)
end
_G.KaiTan_ActiveInstance = ScriptInstanceId

local ScriptConnections = {}
local function SafeConnect(signal, fn)
    local conn
    conn = signal:Connect(function(...)
        if _G.KaiTan_ActiveInstance ~= ScriptInstanceId then
            if conn then pcall(function() conn:Disconnect() end) end
            return
        end
        return fn(...)
    end)
    table.insert(ScriptConnections, conn)
    return conn
end

_G.KaiTan_Cleanup = function()
    for _, conn in ipairs(ScriptConnections) do
        pcall(function() conn:Disconnect() end)
    end
    table.clear(ScriptConnections)
    pcall(function()
        if setfpscap and type(setfpscap) == "function" then setfpscap(60) end
        if HoverBG then HoverBG:Destroy() end
        if HoverBV then HoverBV:Destroy() end
        SafeDestroyGui("KaiTan_HUD")
        SafeDestroyGui("KaiTan_MobileToggle")
    end)
end

