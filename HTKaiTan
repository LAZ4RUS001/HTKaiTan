            end
            root.AssemblyLinearVelocity = Vector3.zero
            -- 1. Sell junk materials and unequipped equipment while at merchant
            pcall(function() Remotes.ShopSellJunk:FireServer() end)
            task.wait(0.1)
            if Config.AutoSellGear then
                pcall(function()
                    local gearsToSell = GetGearToSell()
                    if #gearsToSell > 0 then
                        Remotes.BagSell:FireServer(gearsToSell)
                        local many = {}
                        for _, r in ipairs(gearsToSell) do table.insert(many, { r, 1 }) end
