-- ==================== 60 FPS ULTRA-STABLE HOVER & POSITION TRACKER WITH AUTO DODGE ==================== --
SafeConnect(RunService.Heartbeat, function(dt)
    if not Config.AutoFarm or IsRespawning or IsOpeningChest or IsProcessingEventNpc or IsBuyingPotions or IsSellingGear or IsKnockingHalloween then return end
    local root, hum = GetChar()
    if not root or not hum or hum.Health <= 0 then return end

    -- Guard: Never position or snap towards monsters if player is inside Town
    local inTown = LocalPlayer:GetAttribute("InTown") == true or (root.Position.Z >= -64.25 and root.Position.Z <= 500)
    if inTown then
        CurrentTarget = nil
        return
    end

    -- 1. 100% Auto Dodge Position Override (Evasive Snap outside Danger Zone)
    if Config.AutoDodge and DodgeActiveUntil and os.clock() < DodgeActiveUntil then
        if DodgeTargetPos then
            EnsureHover(root)
            local _, curYaw, _ = root.CFrame:ToOrientation()
            local targetCF = CFrame.new(DodgeTargetPos) * CFrame.Angles(0, curYaw, 0)
            local dist = (root.Position - DodgeTargetPos).Magnitude
            if dist > 35 then
                root.CFrame = targetCF
            else
                local alpha = math.clamp(dt * 20, 0.40, 0.88)
                root.CFrame = root.CFrame:Lerp(targetCF, alpha)
            end
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
            if HoverBG then HoverBG.CFrame = targetCF end
            if HoverBV then HoverBV.Velocity = Vector3.zero end
            return
        end
    end

    -- 2. Normal Combat Positioning (Stand Behind Monster or Hover)
    local target = CurrentTarget
    if target and target.Parent then
        local hp = tonumber(target:GetAttribute("HP")) or 0
        local mobCF, mobPart = GetMobCFrame(target)
        if hp > 0 and mobCF then
            -- Guard: If target is unreasonably far (> 250 studs), drop target instead of teleport-fighting
            local distToMob = (root.Position - mobCF.Position).Magnitude
            if distToMob > 250 then
                CurrentTarget = nil
                return
            end
            EnsureHover(root)

            local extSize = GetCachedMobExtents(target)
            local mobPos = mobCF.Position
            local targetPos, targetCF

            if Config.StandBehind then
                -- Stand strictly behind the monster's back at ground level
                local mobRadius = math.max(extSize.X, extSize.Z) / 2
                local standDist = math.clamp(mobRadius + (Config.StandBehindDist or 3.8), 3.5, 8.5)

                local mobLook = mobCF.LookVector
                local flatLook = Vector3.new(mobLook.X, 0, mobLook.Z)
                if flatLook.Magnitude < 0.1 then
                    flatLook = Vector3.new(0, 0, -1)
                else
                    flatLook = flatLook.Unit
                end

                local behindOffset = -flatLook * standDist
                targetPos = Vector3.new(mobPos.X + behindOffset.X, mobPos.Y + 0.2 + (TemporaryDodgeHeight or 0), mobPos.Z + behindOffset.Z)
                targetCF = CFrame.lookAt(targetPos, Vector3.new(mobPos.X, targetPos.Y, mobPos.Z))
            else
                -- Legacy Hover mode
                local mobHalfHeight = (extSize.Y / 2) + 4.5
                local safeHeight = math.max(Config.SafeHeight or 8.5, mobHalfHeight) + (TemporaryDodgeHeight or 0)
                targetPos = Vector3.new(mobPos.X, mobPos.Y + safeHeight, mobPos.Z)
                local lookDir = Vector3.new(mobPos.X - targetPos.X, 0, mobPos.Z - targetPos.Z)
                if lookDir.Magnitude > 0.1 then
                    targetCF = CFrame.lookAt(targetPos, mobPos)
                else
                    local _, curYaw, _ = root.CFrame:ToOrientation()
                    targetCF = CFrame.new(targetPos) * CFrame.Angles(0, curYaw, 0)
                end
            end

            local dist = (root.Position - targetPos).Magnitude
            if dist > 55 then
                root.CFrame = targetCF
            else
                local alpha = math.clamp(dt * 20, 0.40, 0.88)
                root.CFrame = root.CFrame:Lerp(targetCF, alpha)
            end

            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
            if HoverBG then HoverBG.CFrame = targetCF end
            if HoverBV then HoverBV.Velocity = Vector3.zero end
            return
        end
    end

    EnsureHover(root)
    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero
    if HoverBV then HoverBV.Velocity = Vector3.zero end
end)

