-- ==================== MONSTER POSITION & TARGETING WITH BOSS & QUEST PRIORITY ==================== --
local function GetMobPosition(mob)
    if not mob or not mob.Parent then return nil end
    local pPart = mob.PrimaryPart or mob:FindFirstChild("HumanoidRootPart")
    if pPart then return pPart.Position, pPart end
    local anyPart = mob:FindFirstChildWhichIsA("BasePart")
    if anyPart then return anyPart.Position, anyPart end
    if mob:FindFirstChild("Visual") then
        local vPart = mob.Visual.PrimaryPart or mob.Visual:FindFirstChildWhichIsA("BasePart")
        if vPart then return vPart.Position, vPart end
    end
    local ok, pv = pcall(function() return mob:GetPivot() end)
    if ok and pv then return pv.Position, nil end
    return nil
end

local function GetMobCFrame(mob)
    if not mob or not mob.Parent then return nil, nil end
    local pPart = mob.PrimaryPart or mob:FindFirstChild("HumanoidRootPart")
    if pPart then return pPart.CFrame, pPart end
    local anyPart = mob:FindFirstChildWhichIsA("BasePart")
    if anyPart then return anyPart.CFrame, anyPart end
    if mob:FindFirstChild("Visual") then
        local vPart = mob.Visual.PrimaryPart or mob.Visual:FindFirstChildWhichIsA("BasePart")
        if vPart then return vPart.CFrame, vPart end
    end
    local ok, pv = pcall(function() return mob:GetPivot() end)
    if ok and pv then return pv, nil end
    return nil, nil
end

local function IsBossMob(mob)
    if not mob then return false end
    if mob:GetAttribute("IsBoss") == true or mob:GetAttribute("IsMiniBoss") == true or mob:GetAttribute("IsLeader") == true then
        return true
    end
    local id = tostring(mob:GetAttribute("Id") or mob:GetAttribute("MonsterId") or mob.Name):lower()
    local bossKeywords = {
        "boss", "king", "titan", "queen", "lord", "warden", "leviathan",
        "tyrant", "behemoth", "pharaoh", "sovereign", "goliath", "alpha", "colossus"
    }
    for _, kw in ipairs(bossKeywords) do
        if id:find(kw) then return true end
    end
    return false
end

local function GetBestMonster()
    local root = GetChar()
    if not root then return nil end

    -- 1. Sticky Target: Keep attacking current target until it dies to prevent shaking between mobs
    if CurrentTarget and CurrentTarget.Parent then
        local hp = tonumber(CurrentTarget:GetAttribute("HP")) or 0
        if hp > 0 then
            local mobPos = GetMobPosition(CurrentTarget)
            if mobPos then
                local dist = (mobPos - root.Position).Magnitude
                -- Drop sticky target if too far away (e.g. after death/respawn or warp)
                if dist <= 120 then
                    local inZone = true
                    if CurrentZoneId then
                        local mobZone = GetZoneAtZ(mobPos.Z)
                        if mobZone and mobZone ~= CurrentZoneId then
                            inZone = false
                        end
                    end
                    if inZone then
                        return CurrentTarget
                    end
                end
            end
        end
    end

    -- 2. Target Selection: Boss First -> Quest Target Mob -> Nearest Normal Mob
    local mf = workspace:FindFirstChild("Monsters")
    if not mf then return nil end

    local bestBoss = nil
    local minBossDist = math.huge
    local bestQuestMob = nil
    local minQuestDist = math.huge
    local bestNormal = nil
    local minNormalDist = math.huge

    local questTargets = Config.AutoQuest and CachedQuestTargets or {}

    for _, mob in ipairs(mf:GetChildren()) do
        local hp = tonumber(mob:GetAttribute("HP")) or 0
        if hp > 0 then
            local mobPos = GetMobPosition(mob)
            if mobPos then
                if CurrentZoneId then
                    local mobZone = GetZoneAtZ(mobPos.Z)
                    if mobZone and mobZone ~= CurrentZoneId then
                        continue
                    end
                end
                local dist = (mobPos - root.Position).Magnitude
                local mId = tostring(mob:GetAttribute("Id") or mob:GetAttribute("MonsterId") or mob.Name):lower()
                local isQuestTarget = false
                for qTarget in pairs(questTargets) do
                    if mId:find(qTarget) or qTarget:find(mId) then
                        isQuestTarget = true
                        break
                    end
                end

                if IsBossMob(mob) then
                    if dist < minBossDist then
                        minBossDist = dist
                        bestBoss = mob
                    end
                elseif isQuestTarget then
                    if dist < minQuestDist then
                        minQuestDist = dist
                        bestQuestMob = mob
                    end
                else
                    if dist < minNormalDist then
                        minNormalDist = dist
                        bestNormal = mob
                    end
                end
            end
        end
    end

    local chosenMob = bestBoss or bestQuestMob or bestNormal
    if not chosenMob then
        -- Fallback: If no mob found in strict zone, pick nearest mob within 160 studs
        local fallbackDist = 160
        for _, mob in ipairs(mf:GetChildren()) do
            local hp = tonumber(mob:GetAttribute("HP")) or 0
            if hp > 0 then
                local mobPos = GetMobPosition(mob)
                if mobPos then
                    local dist = (mobPos - root.Position).Magnitude
                    if dist < fallbackDist then
                        fallbackDist = dist
                        chosenMob = mob
                    end
                end
            end
        end
    end

    return chosenMob
end

