    local toSell = {}

    for ref, gData in pairs(gears) do
        if not eqMap[ref] and not locked[ref] and (tonumber(refined[ref]) or 0) <= 0 then
            local r = tonumber(gData.R) or 0
            if r <= maxRarity then
                table.insert(toSell, ref)
            end
        end
    end

    return toSell
end

local function ProcessAutoSellGear(force)
    if not Config.AutoSellGear or IsSellingGear or IsBuyingPotions or IsProcessingEventNpc then return end

    local used = tonumber(LocalPlayer:GetAttribute("BagSlotsUsed")) or 0
    local maxSlots = tonumber(LocalPlayer:GetAttribute("BagSlotsMax")) or 120
    local freeSlots = maxSlots - used
    local ratio = maxSlots > 0 and (used / maxSlots) or 0

    local weight = tonumber(LocalPlayer:GetAttribute("Weight")) or 0
    local maxWeight = tonumber(LocalPlayer:GetAttribute("MaxWeight")) or 1
    local weightRatio = maxWeight > 0 and (weight / maxWeight) or 0

    local thresholdRatio = Config.BagFullThreshold or 0.80
    local minFree = Config.MinFreeBagSlots or 15

    local isNearFull = (freeSlots <= minFree) or (ratio >= thresholdRatio) or (weightRatio >= 0.80)
    if not force and not isNearFull then return end

    local now = os.clock()
    if not force and (now - LastGearSellTime < 10.0) then return end

    -- Guard: Never abandon active boss fight to sell gear
    if CurrentTarget and CurrentTarget.Parent and IsBossMob(CurrentTarget) then
        local bHp = tonumber(CurrentTarget:GetAttribute("HP")) or 0
        if bHp > 0 then return end
    end

    -- Equip best gear and cards first before selling
    if Config.AutoEquipBest then
        pcall(EquipBestGear)
        task.wait(0.2)
    end
    if Config.AutoInsertCards then
        pcall(ProcessAutoInsertCards)
        task.wait(0.2)
    end

    local gearList = GetGearToSell()
    -- CRITICAL FIX: If bag is near full or heavy, proceed to Town even if gearList is empty,
    -- because bag could be full of monster drop materials, junk, etc.!
    if #gearList == 0 and not force and not isNearFull then return end

    IsSellingGear = true
    LastGearSellTime = now

    task.spawn(function()
        pcall(function()
            local root = GetChar()
            if not root then return end

            local savedZoneId = CurrentZoneId
            local savedZoneName = CurrentZoneName

            print(string.format("[spinach] Bag is almost full (%d/%d used, %d free slots, weight %.0f%%)! Visiting Merchant to sell %d equipment items & junk...",
                used, maxSlots, freeSlots, weightRatio * 100, #gearList))

            -- Teleport to Town merchant
            Remotes.WarpTo:FireServer("Town")
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
            root.CFrame = CFrame.new(-50.37, 5.0, 30.46)
            task.wait(0.65)

            -- Confirm proximity to merchant
            local merchant = workspace:FindFirstChild("Map") and workspace.Map:FindFirstChild("NPCs") and workspace.Map.NPCs:FindFirstChild("merchant")
            if merchant and merchant.PrimaryPart then
                root.CFrame = merchant.PrimaryPart.CFrame + Vector3.new(0, 1.5, 2.0)
            else
                root.CFrame = CFrame.new(-50.37, 5.0, 30.46)
            end
            root.AssemblyLinearVelocity = Vector3.zero
            task.wait(0.3)

            -- 1. Sell all monster junk materials
            pcall(function() Remotes.ShopSellJunk:FireServer() end)
            task.wait(0.2)

            -- 2. Sell equipment items (BagSell in batches of 40)
            if #gearList > 0 then
                for i = 1, #gearList, 40 do
                    local batch = {}
                    for j = i, math.min(i + 39, #gearList) do
                        table.insert(batch, gearList[j])
                    end
                    pcall(function() Remotes.BagSell:FireServer(batch) end)
                    task.wait(0.15)
                end
            end

            -- 3. Also call ShopSellJunk again after selling gear
            pcall(function() Remotes.ShopSellJunk:FireServer() end)
            task.wait(0.2)

            -- 4. Check if potions need restocking while already in town
            if Config.AutoBuyPotions then
                pcall(ProcessAutoBuyPotions)
            end

            -- 5. Dismiss WeightAlert Toast if open
            pcall(function()
                local pGui = LocalPlayer:FindFirstChild("PlayerGui")
                local wa = pGui and pGui:FindFirstChild("LumiWeightAlert")
                if wa then
                    for _, d in ipairs(wa:GetDescendants()) do
                        if d:IsA("Frame") and d.Visible then d.Visible = false end
                    end
                end
            end)

            print(string.format("[spinach] Equipment & junk sold successfully! Returning to %s...", savedZoneName or "hunting zone"))

            -- Warp back to hunting zone (always target the latest effective zone)
            local targetZoneId, targetName = GetEffectiveTargetZone(GetPlayerLevel())
            TeleportTo(targetZoneId, targetName)
            task.wait(0.6)
        end)
        IsSellingGear = false
    end)
end

