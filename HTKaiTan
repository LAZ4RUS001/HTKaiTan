-- ==================== AUTO HALLOWEEN WITCH HOUSE KNOCK (TRICK OR TREAT) ==================== --
local function ProcessAutoHalloweenKnock(force)
    if not Config.AutoHalloweenKnock or IsKnockingHalloween or IsSellingGear or IsBuyingPotions or IsProcessingEventNpc or IsOpeningChest then
        return
    end

    local itemsRaw = LocalPlayer:GetAttribute("ItemsJson")
    if type(itemsRaw) ~= "string" or itemsRaw == "" then return end
    local ok1, items = pcall(function() return HttpService:JSONDecode(itemsRaw) end)
    if not ok1 or type(items) ~= "table" then return end

    local candy = tonumber(items["halloween_candy"]) or 0
    local minCandy = Config.MinHalloweenCandy or 100
    if candy < minCandy then return end

    local now = os.clock()
    if not force and (now - LastHalloweenKnockTime < 4.0) then return end

    -- Guard: Never abandon active boss fight
    if CurrentTarget and CurrentTarget.Parent and IsBossMob(CurrentTarget) then
        local bHp = tonumber(CurrentTarget:GetAttribute("HP")) or 0
        if bHp > 0 then return end
    end

    local root, hum = GetChar()
    if not root or not hum or hum.Health <= 0 or IsRespawning then return end

    local houseFolder = workspace:FindFirstChild("Map") and workspace.Map:FindFirstChild("Halloween_TrickTreat")
    if not houseFolder then return end

    local bestPrompt = nil
    local bestSpot = nil
    local bestDist = math.huge

    for _, h in ipairs(houseFolder:GetChildren()) do
        local spot = h:FindFirstChild("KnockSpot")
        local prompt = spot and spot:FindFirstChild("KnockPrompt")
        if prompt and prompt.Enabled then
            local dist = (spot.Position - root.Position).Magnitude
            if dist < bestDist then
                bestDist = dist
                bestPrompt = prompt
                bestSpot = spot
            end
        end
    end

    if not bestPrompt or not bestSpot then return end

    IsKnockingHalloween = true
    LastHalloweenKnockTime = now
    CurrentTarget = nil

    task.spawn(function()
        pcall(function()
            local origCF = root.CFrame

            print(string.format("🎃 Auto Halloween: Visiting %s to knock with %d candies...", bestSpot.Parent.Name, candy))

            -- Stop physics & velocity
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
            if HoverBV then HoverBV.Velocity = Vector3.zero end

            -- Teleport directly in front of the knock spot facing it
            local spotPos = bestSpot.Position
            local standPos = spotPos + Vector3.new(0, 1.2, 0)
            local targetCF = CFrame.lookAt(standPos + Vector3.new(0, 0, 2), spotPos)
            root.CFrame = targetCF
            if HoverBG then HoverBG.CFrame = targetCF end
            task.wait(0.5)

            -- Knock repeatedly while candies >= minCandy (up to 10 knocks per batch)
            local knocksDone = 0
            while knocksDone < 10 do
                local curItemsRaw = LocalPlayer:GetAttribute("ItemsJson") or "{}"
                local curItems = (type(curItemsRaw) == "string" and HttpService:JSONDecode(curItemsRaw)) or {}
                local curCandy = tonumber(curItems["halloween_candy"]) or 0
                if curCandy < minCandy then break end

                -- Anchor at knock spot
                root.AssemblyLinearVelocity = Vector3.zero
                root.AssemblyAngularVelocity = Vector3.zero
                root.CFrame = targetCF
                if HoverBV then HoverBV.Velocity = Vector3.zero end
                if HoverBG then HoverBG.CFrame = targetCF end

                if fireproximityprompt then
                    fireproximityprompt(bestPrompt, 0)
                else
                    bestPrompt:InputHoldBegin()
                    task.wait(0.08)
                    bestPrompt:InputHoldEnd()
                end

                knocksDone = knocksDone + 1

                -- Wait for door animation & TrickTreat cooldown (3.5 seconds)
                local waitStart = os.clock()
                while (os.clock() - waitStart < 3.5) do
                    task.wait(0.2)
                    local checkItems = (pcall(function() return HttpService:JSONDecode(LocalPlayer:GetAttribute("ItemsJson") or "{}") end) and HttpService:JSONDecode(LocalPlayer:GetAttribute("ItemsJson") or "{}")) or {}
                    if (tonumber(checkItems["halloween_candy"]) or 0) < curCandy and (os.clock() - waitStart >= 2.0) and bestPrompt.Enabled then
                        break
                    end
                end
            end

            print(string.format("[spinach] 🎃 Witch's House knock finished! Successfully exchanged %d times.", knocksDone))

            -- Restore position cleanly
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
            root.CFrame = origCF
            if HoverBG then HoverBG.CFrame = origCF end
            task.wait(0.3)
        end)
        IsKnockingHalloween = false
    end)
end

