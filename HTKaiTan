local function ClampPosToZone(pos, margin)
    margin = margin or 16
    local curZId = CurrentZoneId
    local zRange = nil
    if curZId then
        for _, zr in ipairs(ZoneRanges) do
            if zr.id == curZId then zRange = zr break end
        end
    end
    if not zRange then
        _, zRange = GetZoneAtZ(pos.Z)
    end

    local minX = zRange and (zRange.minX + margin) or -60
    local maxX = zRange and (zRange.maxX - margin) or 60
    local clampedX = math.clamp(pos.X, minX, maxX)
    local clampedZ = pos.Z

    if zRange then
        local minZ = zRange.minZ + margin
        local maxZ = zRange.maxZ - margin
        if minZ > maxZ then
            clampedZ = (zRange.minZ + zRange.maxZ) / 2
        else
            clampedZ = math.clamp(pos.Z, minZ, maxZ)
        end
    end
    return Vector3.new(clampedX, pos.Y, clampedZ)
end

local function CalculateSmartBossEvade(rootPos, dangerCenter, dangerRadius, safeZoneCenter)
    local margin = 16
    local curZId = CurrentZoneId
    local zRange = nil
    if curZId then
        for _, zr in ipairs(ZoneRanges) do
            if zr.id == curZId then zRange = zr break end
        end
    end
    if not zRange then
        _, zRange = GetZoneAtZ(rootPos.Z)
    end

    -- 1. If an official Green Safe Circle exists, ALWAYS prioritize moving inside it!
    if safeZoneCenter then
        local safePos = Vector3.new(safeZoneCenter.X, rootPos.Y + 3.0, safeZoneCenter.Z)
        return ClampPosToZone(safePos, margin)
    end

    -- 2. Evade radially outside of Red Danger Circle (Radius + 6.0 studs)
    local reqDist = (dangerRadius or 22) + 6.0
    local bestCandidate = nil
    local bestDist = math.huge

    local minX = zRange and (zRange.minX + margin) or -60
    local maxX = zRange and (zRange.maxX - margin) or 60
    local minZ = zRange and (zRange.minZ + margin) or (rootPos.Z - 60)
    local maxZ = zRange and (zRange.maxZ - margin) or (rootPos.Z + 60)

    for i = 0, 15 do
        local angle = (i / 16) * math.pi * 2
        local offset = Vector3.new(math.cos(angle) * reqDist, 0, math.sin(angle) * reqDist)
        local cand = dangerCenter + offset

        if cand.X >= minX and cand.X <= maxX and cand.Z >= minZ and cand.Z <= maxZ then
            local dist = (Vector3.new(cand.X, 0, cand.Z) - Vector3.new(rootPos.X, 0, rootPos.Z)).Magnitude
            if dist < bestDist then
                bestDist = dist
                bestCandidate = cand
            end
        end
    end

    if bestCandidate then
        return Vector3.new(bestCandidate.X, rootPos.Y + 3.0, bestCandidate.Z)
    end

    -- 3. Fallback: Evade upward
    return Vector3.new(rootPos.X, rootPos.Y + 14.0, rootPos.Z)
end

