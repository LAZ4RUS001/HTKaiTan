local function ProcessAutoQuests()
    if not Config.AutoQuest then return end
    pcall(function()
        local raw = LocalPlayer:GetAttribute("QuestsJson")
        if type(raw) ~= "string" then return end
        local pData = HttpService:JSONDecode(raw)
        if type(pData) ~= "table" then return end

        local Shared = ReplicatedStorage:FindFirstChild("Shared")
        if not Shared or not Shared:FindFirstChild("QuestData") then return end
        local QuestData = require(Shared.QuestData)

        local active = pData.Active or {}
        local done = pData.Done or {}
        local daily = pData.Daily or {}
        local today = pData.Today or 0
        local pLvl = GetPlayerLevel()
        local itemsRaw = LocalPlayer:GetAttribute("ItemsJson")
        local items = (type(itemsRaw) == "string" and HttpService:JSONDecode(itemsRaw)) or {}

        -- 1. Check and Claim Completed Active Quests
        local questSummaryList = {}
        for qId, curVal in pairs(active) do
            local qDef = QuestData.Quests[qId]
            if qDef then
                local current = tonumber(curVal) or 0
                if qDef.Type == "collect" then
                    current = tonumber(items[qDef.Target]) or 0
                elseif qDef.Type == "level" then
                    current = pLvl
                elseif qDef.Type == "check" then
                    current = 1 -- เควสประเภท Check สามารถกดรับได้ทันทีโดยไม่ต้องเปิดหน้าต่าง GUI ให้ขวางจอ
                end

                table.insert(questSummaryList, string.format("%s (%d/%d)", qDef.Target or qId, math.min(current, qDef.Count or 1), qDef.Count or 1))

                if current >= (qDef.Count or 1) then
                    Remotes.QuestAction:FireServer("claim", qId)
                    task.wait(0.08)
                end
            end
        end

        CurrentQuestSummary = #questSummaryList > 0 and table.concat(questSummaryList, ", ") or "None"

        -- 2. Sort Quests by Order to find Next Main Quest
        local sortedQuests = {}
        for qId, def in pairs(QuestData.Quests) do
            table.insert(sortedQuests, { Id = qId, Def = def })
        end
        table.sort(sortedQuests, function(a, b) return (a.Def.Order or 0) < (b.Def.Order or 0) end)

        local nextMain = nil
        for _, item in ipairs(sortedQuests) do
            local def = item.Def
            if not def.Guide and not def.Daily and not def.Repeat and not done[item.Id] then
                nextMain = item.Id
                break
            end
        end

        -- 3. Accept Next Main Quest if available
        if nextMain and not active[nextMain] then
            local def = QuestData.Quests[nextMain]
            if def and pLvl >= (def.ReqLevel or 1) then
                Remotes.QuestAction:FireServer("accept", nextMain)
                task.wait(0.08)
            end
        end

        -- 4. Accept Daily Quests if available today
        for _, item in ipairs(sortedQuests) do
            local qId = item.Id
            local def = item.Def
            if def.Daily and not active[qId] and (daily[qId] ~= today) then
                if pLvl >= (def.ReqLevel or 1) then
                    Remotes.QuestAction:FireServer("accept", qId)
                    task.wait(0.08)
                end
            end
        end

        -- 5. Accept Best Repeatable Quest for Current Level / Zone
        local bestRepeat = nil
        for _, item in ipairs(sortedQuests) do
            local qId = item.Id
            local def = item.Def
            if def.Repeat and pLvl >= (def.ReqLevel or 1) then
                bestRepeat = qId
            end
        end

        if bestRepeat and not active[bestRepeat] then
            local hasActiveRepeat = false
            for aId in pairs(active) do
                local aDef = QuestData.Quests[aId]
                if aDef and aDef.Repeat then
                    hasActiveRepeat = true
                    break
                end
            end
            if not hasActiveRepeat then
                Remotes.QuestAction:FireServer("accept", bestRepeat)
                task.wait(0.08)
            end
        end
    end)
end

